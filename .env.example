# Supabase Configuration (Required)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase is optional. It backs analytics and the chat transcript log only.
# If it's absent the site still works and the assistant still answers.

# The Anthropic API key is NOT set here. It's an ANTHROPIC_API_KEY environment
# variable on the Cloudflare Pages project, read server-side by the /api/chat
# Pages Function. Never give it a VITE_ prefix - Vite inlines those into the
# public bundle.
